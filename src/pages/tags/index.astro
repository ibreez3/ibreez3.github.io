---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');

// 提取所有标签
const tags = new Map<string, { count: number; posts: any[] }>();
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    if (!tags.has(tag)) {
      tags.set(tag, { count: 0, posts: [] });
    }
    tags.get(tag)!.count++;
    tags.get(tag)!.posts.push(post);
  });
});

// 按标签使用次数排序
const sortedTags = Array.from(tags.entries()).sort((a, b) =>
  b[1].count - a[1].count
);
---

<Layout
  title="所有标签"
  description="浏览博客文章标签，通过标签快速找到相关内容"
>
  <div class="page-header">
    <h1 class="page-title">标签云</h1>
    <p class="page-subtitle">共 {tags.size} 个标签</p>
  </div>

  <div class="tags-cloud">
    {sortedTags.map(([tag, info]) => (
      <a href={`/tags/${tag}`} class="tag-item" style={`--tag-size: ${getTagSize(info.count)};`}>
        <span class="tag-text">#{tag}</span>
        <span class="tag-count">{info.count}</span>
      </a>
    ))}
  </div>
</Layout>

<script>
  function getTagSize(count: number): number {
    // 根据文章数量计算标签大小
    if (count === 1) return 0.9;
    if (count <= 2) return 1.0;
    if (count <= 4) return 1.1;
    return 1.2;
  }
</script>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Tags Cloud */
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: white;
    border: 2px solid var(--color-border);
    border-radius: 9999px;
    padding: 12px 20px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .tag-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-primary);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 0;
  }

  .tag-item:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 8px 16px rgba(37, 99, 235, 0.2);
    border-color: var(--color-primary);
  }

  .tag-item:hover::before {
    opacity: 0.1;
  }

  .tag-text {
    font-size: calc(0.9375rem * var(--tag-size));
    font-weight: 600;
    color: var(--color-text);
    position: relative;
    z-index: 1;
    transition: color 0.3s;
  }

  .tag-item:hover .tag-text {
    color: var(--color-primary);
  }

  .tag-count {
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9999px;
    position: relative;
    z-index: 1;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .tags-cloud {
      gap: 8px;
    }

    .tag-item {
      padding: 10px 16px;
    }

    .tag-text {
      font-size: calc(0.875rem * var(--tag-size));
    }
  }
</style>
