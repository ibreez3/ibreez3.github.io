---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, pubDate, categories, tags, description } = post.data;

// 计算阅读时间（中文每分钟约 400 字）
const readTime = Math.ceil(Content.length / 400);

// 跳过 H1（页面已有标题），只保留 H2 和 H3
const { headings } = await post.render();
const toc = headings.filter(h => h.depth <= 3 && h.depth >= 2);
---

<Layout
  title={title}
  description={description}
  url={`/posts/${post.slug}`}
  type="article"
>
  <article class="article">
    <div class="article-header-wrapper">
      <div class="article-header">
        <div class="header-meta">
          {categories && categories.length > 0 && (
            <a href={`/categories/${categories[0]}`} class="category-badge">
              {categories[0]}
            </a>
          )}
          <time datetime={pubDate.toISOString()} class="article-date">
            {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>

        <h1 class="article-title">{title}</h1>

        {description && <p class="article-excerpt">{description}</p>}

        <div class="article-meta">
          <span class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            {readTime} 分钟阅读
          </span>
          <span class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            {tags.length} 个标签
          </span>
        </div>
      </div>
    </div>

    <!-- 目录导航 -->
    {toc.length > 0 && (
      <aside class="toc">
        <div class="toc-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="6" x2="21" y2="6"/>
            <line x1="8" y1="12" x2="21" y2="12"/>
            <line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/>
            <line x1="3" y1="12" x2="3.01" y2="12"/>
            <line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
          <span>目录</span>
        </div>
        <ul class="toc-list">
          {toc.map(heading => (
            <li class={`toc-item toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <!-- 文章内容 -->
    <div class="article-content">
      <Content />
    </div>

    <!-- 文章底部标签 -->
    {tags && tags.length > 0 && (
      <div class="article-tags">
        <span class="tags-label">标签：</span>
        {tags.map(tag => (
          <a href={`/tags/${tag}`} class="tag">#{tag}</a>
        ))}
      </div>
    )}
  </article>
</Layout>

<style>
  article {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* 文章头部容器 */
  .article-header-wrapper {
    position: relative;
    z-index: 2;
    background: white;
  }

  .article-header {
    padding-bottom: 40px;
    margin-bottom: 48px;
    border-bottom: 2px solid var(--color-border);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
    color: #1e40af;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.1);
  }

  .category-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(37, 99, 235, 0.15);
  }

  .article-date {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 20px 0;
    color: var(--color-text);
    letter-spacing: -0.02em;
    position: relative;
    z-index: 3;
  }

  .article-excerpt {
    font-size: 1.1875rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0 0 24px 0;
    position: relative;
    z-index: 3;
  }

  .article-meta {
    display: flex;
    gap: 24px;
    align-items: center;
    position: relative;
    z-index: 3;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .meta-item svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* 目录 */
  .toc {
    background: #f9fafb;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 48px;
    position: relative;
    z-index: 2;
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .toc-header svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 10px;
  }

  .toc-item a {
    display: block;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    transition: all 0.2s;
  }

  .toc-item a:hover {
    color: var(--color-primary);
    background: #eff6ff;
    padding-left: 18px;
  }

  .toc-depth-2 {
    font-weight: 600;
  }

  .toc-depth-3 {
    padding-left: 32px;
  }

  .toc-depth-3 a {
    font-size: 0.875rem;
  }

  /* 文章内容 */
  .article-content {
    position: relative;
    z-index: 1;
    background: white;
  }

  .article-content :global(h1) {
    display: none; /* 隐藏文章内容中的 H1，避免重复 */
  }

  .article-content :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 56px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-border);
    letter-spacing: -0.01em;
    position: relative;
  }

  .article-content :global(h3) {
    font-size: 1.375rem;
    font-weight: 600;
    margin-top: 44px;
    margin-bottom: 16px;
    color: #374151;
  }

  .article-content :global(p) {
    margin-bottom: 24px;
    line-height: 1.8;
    position: relative;
    z-index: 1;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 24px;
    padding-left: 28px;
  }

  .article-content :global(li) {
    margin-bottom: 12px;
    line-height: 1.75;
  }

  .article-content :global(pre) {
    background: #1f2937;
    color: #e5e7eb;
    padding: 20px;
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: 24px 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    box-shadow: var(--shadow-md);
    position: relative;
    z-index: 1;
  }

  .article-content :global(code) {
    background: #f3f4f6;
    color: #e11d48;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.875em;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
    border: 1px solid #e5e7eb;
  }

  .article-content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    border: none;
    font-size: 1em;
  }

  .article-content :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.2s;
  }

  .article-content :global(a:hover) {
    color: var(--color-primary-hover);
    border-bottom-color: var(--color-primary);
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    background: #eff6ff;
    padding: 20px 24px;
    margin: 28px 0;
    color: #1e40af;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    position: relative;
    z-index: 1;
  }

  .article-content :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }

  /* 标签 */
  .article-tags {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    position: relative;
    z-index: 1;
  }

  .tags-label {
    font-weight: 600;
    color: var(--color-text);
    margin-right: 12px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    background: #f3f4f6;
    color: var(--color-text-secondary);
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    margin-right: 8px;
    margin-bottom: 8px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid transparent;
    position: relative;
    z-index: 1;
  }

  .tag:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .article-title {
      font-size: 2rem;
    }

    .article-excerpt {
      font-size: 1.0625rem;
    }

    .header-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .article-meta {
      flex-wrap: wrap;
      gap: 16px;
    }

    .toc {
      padding: 20px;
    }

    .article-content :global(h2) {
      font-size: 1.5rem;
      margin-top: 40px;
    }

    .article-content :global(h3) {
      font-size: 1.25rem;
      margin-top: 32px;
    }
  }
</style>
