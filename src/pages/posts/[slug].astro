---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, date, category, tags, description } = post.data;
---

<Layout title={title}>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <time>{date.toLocaleDateString('zh-CN')}</time>
        {category && (
          <>
            {' · '}
            <a href={`/categories/${category}`} class="category">{category}</a>
          </>
        )}
      </div>
      {description && <p class="description">{description}</p>}
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">#{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  article {
    max-width: 800px;
    margin: 0 auto;
  }

  header {
    margin-bottom: 40px;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .meta {
    color: #6b7280;
    font-size: 0.875rem;
    margin-bottom: 12px;
  }

  .category {
    display: inline-block;
    background: #dbeafe;
    color: #1e40af;
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 10px;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .category:hover {
    background: #bfdbfe;
  }

  .description {
    color: #4b5563;
    font-size: 1.125rem;
    margin: 0 0 16px 0;
  }

  .tags {
    margin-top: 12px;
  }

  .tag {
    display: inline-block;
    background: #f3f4f6;
    color: #4b5563;
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.75rem;
    margin-right: 8px;
    margin-bottom: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .tag:hover {
    background: #e5e7eb;
    color: #1f2937;
  }

  .content {
    line-height: 1.8;
    color: #1f2937;
  }

  .content :global(h2) {
    font-size: 1.75rem;
    margin-top: 48px;
    margin-bottom: 16px;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 8px;
  }

  .content :global(h3) {
    font-size: 1.5rem;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .content :global(p) {
    margin-bottom: 24px;
  }

  .content :global(pre) {
    background: #1f2937;
    color: #e5e7eb;
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 24px;
  }

  .content :global(code) {
    background: #f3f4f6;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.875em;
  }

  .content :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .content :global(a) {
    color: #2563eb;
    text-decoration: underline;
  }

  .content :global(blockquote) {
    border-left: 4px solid #e5e7eb;
    padding-left: 16px;
    margin: 24px 0;
    color: #6b7280;
  }

  .content :global(ul), .content :global(ol) {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .content :global(li) {
    margin-bottom: 8px;
  }
</style>
